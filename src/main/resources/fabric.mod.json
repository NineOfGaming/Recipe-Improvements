{
  "schemaVersion": 1,
  "id": "recipe_fallback",
  "version": "${version}",
  "name": "Recipe QoL",
  "description": "Fixes empty recipe syncs via client side fallback and adds recipe-book QoL, tooltip improvements, quick-craft shortcuts, and more.",
  "authors": ["NineOfGaming"],
  "contact": {
    "homepage": "https://modrinth.com/mod/recipe-qol",
    "issues": "https://github.com/NineOfGaming/Recipe-QoL/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/recipe_fallback/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.nineofgaming.recipe_fallback.RecipeFallback"
    ],
    "modmenu": [
      "dev.nineofgaming.recipe_fallback.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "recipe_fallback.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "yet_another_config_lib_v3": ">=${yacl_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "Modrinth": "https://modrinth.com/mod/recipe-qol",
        "GitHub": "https://github.com/NineOfGaming/Recipe-QoL",
        "Ko-fi": "https://ko-fi.com/nineofgaming"
      }
    }
  }
}
